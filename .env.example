# =============================================================================
# Environment template — copy to `.env` and fill in. NEVER commit real secrets;
# only this template (no values) is tracked.
#
# ONE switch controls the whole payment stack: NEXT_PUBLIC_APP_ENV.
#   production → Base mainnet (real USDC) + live Stripe + Coinbase CDP facilitator
#   test       → Base Sepolia (test USDC) + Stripe test mode + free x402 facilitator
# The network, USDC token, EIP-712 asset name/version and facilitator are all
# DERIVED from this in shared/utils/payments.ts — you never set them by hand, so
# a deploy can't end up half on mainnet and half on testnet. instrumentation.ts
# refuses to boot if your Stripe/CDP keys don't match the chosen mode.
# =============================================================================

# --- Deploy mode (required) --------------------------------------------------
# "production" or "test".
NEXT_PUBLIC_APP_ENV=test

# --- Core --------------------------------------------------------------------
DATABASE_URL=postgresql://...
BETTER_AUTH_SECRET=
# Public origin of THIS deploy (test and prod must differ).
BETTER_AUTH_URL=http://localhost:3000
# Canonical site URL for SEO. Optional — falls back to BETTER_AUTH_URL.
# NEXT_PUBLIC_SITE_URL=https://gathra.app

# --- Stripe ------------------------------------------------------------------
# production → sk_live_… / pk_live_…   |   test → sk_test_… / pk_test_…
# Boot will fail if the key mode doesn't match NEXT_PUBLIC_APP_ENV.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# whsec_… from `stripe listen` (test) or the Dashboard webhook endpoint (live).
# Test and live mode each have their OWN webhook signing secret.
STRIPE_WEBHOOK_SECRET=

# --- Crypto: on-page "Pay with USDC" button ----------------------------------
# The wallet that RECEIVES on-page USDC transfers. Leave blank to hide the
# button. Chain id + USDC token contract are derived from NEXT_PUBLIC_APP_ENV.
NEXT_PUBLIC_USDC_RECIPIENT_ADDRESS=

# --- Crypto: x402 agent API (HTTP 402) ---------------------------------------
# The wallet that receives the agent's USDC. Set it to require payment on
# POST /api/v1/bookings; leave blank to keep that endpoint free.
X402_PAY_TO=
# Coinbase CDP Secret API Key (https://portal.cdp.coinbase.com). REQUIRED in
# production (mainnet facilitator). Ignored in test mode.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- Image uploads (Supabase Storage) — optional -----------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth — optional -------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI listing copy (Groq) — optional ---------------------------------------
GROQ_API_KEY=

# --- Email (Resend) — optional -----------------------------------------------
# "true" to actually send; otherwise messages are logged to the console.
RESEND_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
