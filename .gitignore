# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
DAILY_REPORT.md

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but keep the secret-free templates so deploys are reproducible.
!.env.example

# vercel
.vercel

# deploy copy (generated by copy-to-deploy.sh)
/deploy

# staging copy (generated by copy-to-staging.sh)
/staging

# typescript
*.tsbuildinfo
next-env.d.ts
